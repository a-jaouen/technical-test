{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "rolldown -c",
    "start": "node --env-file-if-exists=.env dist/app.js",
    "test": "vitest run",
    "lint": "tsc && oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@scalar/express-api-reference": "^0.10.41",
    "axios": "^1.21.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "joi": "^18.3.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/swagger-jsdoc": "^6.0.4",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "rolldown": "^1.3.3",
    "swagger-jsdoc": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=26"
  }
}
